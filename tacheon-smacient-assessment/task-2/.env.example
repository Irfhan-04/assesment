# =============================================================================
# CoinGecko → BigQuery Pipeline — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in your actual values before running.
# The .env file is in .gitignore and must never be committed.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   python pipeline.py
# =============================================================================


# ---- GCP Configuration (required) ------------------------------------------

# Your GCP project ID. Find this in the BigQuery console top bar.
# Format: adjective-noun-123456
GCP_PROJECT_ID=your-gcp-project-id-here

# BigQuery dataset name. Must already exist before running the pipeline.
# Create it at: console.cloud.google.com/bigquery → your project → Create Dataset
BQ_DATASET_ID=crypto_market_data

# BigQuery table name. Created automatically on first pipeline run.
BQ_TABLE_ID=coin_markets


# ---- Authentication ---------------------------------------------------------

# Option A (local development — recommended for Sandbox):
#   Run: gcloud auth application-default login
#   No file path needed. The BigQuery client finds credentials automatically.

# Option B (CI/CD or production — service account JSON):
#   Create a service account with BigQuery Data Editor + BigQuery Job User roles.
#   Download the JSON key and set the path below.
#   Uncomment this line and set the path:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json


# ---- CoinGecko API Parameters (optional — defaults shown) -------------------

# Quote currency for all price fields. CoinGecko supports usd, eur, gbp, etc.
COINGECKO_VS_CURRENCY=usd

# Number of coins to fetch per API call. Max 250 on free tier.
COINGECKO_PER_PAGE=100

# Page number for pagination. Page 1 returns coins ranked 1–per_page by market cap.
COINGECKO_PAGE=1

# HTTP request timeout in seconds. Increase if you see timeout errors.
REQUEST_TIMEOUT_SECONDS=30


# ---- BigQuery Write Behaviour (optional) ------------------------------------

# WRITE_APPEND: each run appends a time-stamped snapshot (default, recommended).
#   Use this to build a queryable time series. Query the latest run with:
#   WHERE fetched_at = (SELECT MAX(fetched_at) FROM ...)
#
# WRITE_TRUNCATE: each run replaces all existing rows.
#   Use this only if you do not need historical snapshots.
BQ_WRITE_MODE=WRITE_APPEND